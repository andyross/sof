config DCACHE_LINE_SIZE
	default 128

config CPU_HAS_DCACHE
	default y

config DCACHE
	default y

config CACHE_MANAGEMENT
	default y

config XTENSA_CCOUNT_HZ
	default 800000000

# Assume =y with Zephyr builds
config ZEPHYR_LOG
	default y

# Used to be selected by the platform, find a home
config SCHEDULE_DMA_MULTI_CHANNEL
	default y if SOC_FAMILY_MTK

# SOF code assumes system work queue and other system
# wide threads are pinned to a single core.
# CPU_MASK_PIN_ONLY must be set for all SOF builds.
config SCHED_CPU_MASK_PIN_ONLY
	default y if SMP

config SMP_BOOT_DELAY
	default y if SMP

# Zephyr platforms don't use legacy tracing
config TRACE
	default n

# FIXME: figure this out, "host page table", MTK/NXP both need it, old
# old flag (see commit fb784218b500).  But I **think** MTK doesn't
# care about host addresses?  Might be just cut/paste
config HOST_PTABLE
	default y if CONFIG_SOC_FAMILY_MTK

source "Kconfig.zephyr"

